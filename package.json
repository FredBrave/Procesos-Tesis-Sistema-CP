{
  "name": "guiospro",
  "version": "1.0.0",
  "private": true,
  "description": "GUIOS PRO - Sistema de evaluacion para la adopcion de software (guia GUIOS, tesis doctoral Rea Sanchez 2022)",
  "scripts": {
    "build:data": "python scripts/build_data.py && python scripts/build_seed_sql.py",
    "test": "node --test \"tests/**/*.test.js\"",
    "serve": "python -m http.server 8080 --directory app",
    "build:jira": "python scripts/build_jira.py",
    "build:diagramas": "python scripts/build_diagramas.py",
    "build:informe": "python scripts/docx/dimensiones.py && node scripts/docx/informe.js",
    "check:generated": "npm run build:data && git diff --exit-code -- app/js/data.js db/seed.sql"
  },
  "devDependencies": {
    "docx": "^9.5.1"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
